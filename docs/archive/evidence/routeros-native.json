  "limitations": [
    "Some earlier timeouts were caused by a transit MTU bug now corrected; others remain unclassified. Passing functional checks does not guarantee uninterrupted WARP service.",
    "Some failed development cases required installer fixes or test harness corrections before the recorded passing reruns.",
    "Update fixtures share the r14 runtime; this does not validate a future WARP release."
  ],
  "development_findings": [
    {
      "name": "Cold non-private-source TLS stall",
      "observed": "TCP setup succeeded, but large TLS segments retransmitted without ICMP size feedback at bridge MTU 1500. A prior private-source request could warm the destination MTU cache and mask the failure.",
      "correction": "Bridge MTU 1300 lets RouterOS send packet-too-large feedback before traffic enters WARP. No runtime image change or extra firewall rule.",
      "validation": "Negative control reproduced timeout; correction delivered ICMP MTU 1300 and four Google IPv4 targets returned 204 on their first request. Process IDs and registration unchanged."
    }
  ]
